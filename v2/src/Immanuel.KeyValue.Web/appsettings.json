{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "KeyValue": {
    "DataDirectory": "App_Data",
    "MaxKeyLength": 64,
    "MaxValueLength": 1024,
    "MaxKeysPerAppKey": 1000,
    "AutoCreateUnknownAppKeys": false
  },

  "RateLimit": {
    "Enabled": true,
    "PermitsPerMinute": 300,
    "QueueLimit": 0
  },

  "Proxy": {
    "Enabled": true,
    "TrustAllProxies": false,
    "KnownProxies": []
  }
}
