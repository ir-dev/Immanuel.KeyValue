{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "KeyValue": {
    "DataDirectory": "App_Data",
    "MaxKeyLength": 64,
    "MaxValueLength": 1024,
    "MaxKeysPerAppKey": 1000,
    "AutoCreateUnknownAppKeys": false
  },

  "Auth": {
    "Enabled": true,
    "MasterOtp": "000000",
    "RevealMasterOtp": false,
    "OtpLifetimeMinutes": 10,
    "OtpMaxAttempts": 5,
    "SessionLifetimeHours": 336,
    "MaxAppKeysPerUser": 10,

    "//Smtp": "Leave Host empty and every sign-in accepts MasterOtp instead. Put real credentials in appsettings.Development.json, which is git-ignored.",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "UseSsl": true,
      "UserName": "",
      "Password": "",
      "FromAddress": "",
      "FromName": "Immanuel KeyValue"
    }
  },

  "RateLimit": {
    "Enabled": true,
    "PermitsPerMinute": 300,
    "QueueLimit": 0
  },

  "Proxy": {
    "Enabled": true,
    "TrustAllProxies": false,
    "KnownProxies": []
  }
}
