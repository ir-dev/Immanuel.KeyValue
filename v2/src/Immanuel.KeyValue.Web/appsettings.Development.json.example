{
  "//": "Copy to appsettings.Development.json for local overrides. That file is git-ignored.",
  "//_": "The app runs fine without it - everything here just overrides appsettings.json.",

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "KeyValue": {
    "//": "Point at a scratch folder so local testing never touches real data.",
    "DataDirectory": "App_Data",
    "AutoCreateUnknownAppKeys": false
  },

  "Auth": {
    "//": "With no SMTP host, every sign-in accepts MasterOtp. RevealMasterOtp puts it in the",
    "//_": "sign-in response so the console can fill it in - convenient locally, never in production.",
    "MasterOtp": "424242",
    "RevealMasterOtp": true,

    "//Smtp": "Fill this in to send real codes. This file is git-ignored, which is where a relay password belongs.",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "UseSsl": true,
      "UserName": "",
      "Password": "",
      "FromAddress": "keyvalue@example.com"
    }
  },

  "RateLimit": {
    "//": "Usually worth turning off while developing.",
    "Enabled": false
  }
}
